<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit, instanced from the variable font into the four weights the app uses.
     Static instances rather than the variable file so API 24 and 25, which have
     no font-variation support, still get the right weight. -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/outfit_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        app:font="@font/outfit_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        app:font="@font/outfit_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        app:font="@font/outfit_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>

<?xml version="1.0" encoding="utf-8"?>
<!-- Price tag, drawn as an outline to match the rest of the set: stroked paths,
     no fill. The body is a rounded rectangle rotated 45 degrees, so the corners
     stay even and the shape reads as a tag at 24dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

    <group
        android:pivotX="128"
        android:pivotY="132"
        android:rotation="45">
        <path
            android:pathData="M52,100 L204,100 Q220,100 220,116 L220,148 Q220,164 204,164 L52,164 Q36,164 36,148 L36,116 Q36,100 52,100 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="14"
            android:strokeLineJoin="round" />
    </group>

    <!-- The hole the string runs through. -->
    <path
        android:pathData="M166,74 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="14" />

    <!-- The string itself, looping off the top-right corner. -->
    <path
        android:pathData="M179,74 C199,54 219,62 219,82 C219,98 205,104 194,98"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="14"
        android:strokeLineCap="round" />
</vector>

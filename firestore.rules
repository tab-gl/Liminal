rules_version = '2';

// ---------------------------------------------------------------------------
// Sproutly Firestore security rules
//
// These rules carry the weight that Cloud Functions would normally carry,
// because the app has to run on the Firebase Spark plan (no functions). Every
// number that matters — prices, stock, order totals, status transitions, roles
// — is re-checked here at commit time.
//
// Principles:
//   1. Roles are read from users/{uid} server-side; never from the request.
//   2. A shopper can always read their own data and never anyone else's.
//   3. Anything the client is not explicitly allowed to do is denied.
//
// Known limits of running without a server (documented in docs/SPARK-MODE.md):
//   • A signed-in user may adjust a product's stock/unitsSold fields. Oversell
//     is impossible (stock can never go below zero) and prices cannot be
//     touched, but stock is not cryptographically bound to a specific order.
//   • Cloudinary asset deletion needs the api_secret, so removing a product
//     leaves its images for manual cleanup in the Cloudinary console.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Every helper below is written so that a *missing* document can never
    // become an evaluation error: an error denies the whole rule, which turns a
    // recoverable gap (no profile yet, store deleted) into "permission denied"
    // everywhere. Missing means "not there", and the rule falls through.
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()));
    }

    function userDoc() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(uid())).data
        : {};
    }

    // Normalised to lower case: a role typed by hand in the console is very
    // often "admin" or "Admin", and comparing case-sensitively meant the app
    // showed the admin console while every write was denied.
    // A signed-in account can have no profile document yet (a second account
    // created elsewhere, or a write that failed). Reading .role on a missing
    // document is an evaluation error, and an error denies the whole rule — so
    // the document is checked first and a missing profile means 'guest'.
    function role() {
      return hasUserDoc() && userDoc().role is string
        ? userDoc().role.lower()
        : 'guest';
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isSeller() {
      return isSignedIn() && (role() == 'seller' || role() == 'admin');
    }

    function myStoreId() {
      return hasUserDoc() && userDoc().storeId is string ? userDoc().storeId : null;
    }

    function hasStore(storeId) {
      return storeId is string
        && exists(/databases/$(database)/documents/stores/$(storeId));
    }

    function storeDoc(storeId) {
      return hasStore(storeId)
        ? get(/databases/$(database)/documents/stores/$(storeId)).data
        : {};
    }

    function unchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // --------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == uid() || isAdmin());

      allow create: if isSignedIn() && userId == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'CUSTOMER'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;

      // Admins moderate roles (Admin console → Roles and access). Without this
      // branch the screen could open and never save anything.
      allow update: if isAdmin();

      allow update: if isSignedIn() && userId == uid() && (
          // Ordinary profile edits: identity fields are frozen.
          (unchanged('role') && unchanged('storeId') && unchanged('createdAt')
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 80)
          ||
          // Becoming a seller: only from CUSTOMER, only towards a store the
          // caller actually owns.
          // The store is created in the same batch as this promotion, so it is
          // not visible to get() yet — only getAfter()/existsAfter() see the
          // pending write. Using get() here denied every developer conversion.
          (resource.data.role is string
            && resource.data.role.lower() == 'customer'
            && request.resource.data.role == 'SELLER'
            && request.resource.data.storeId is string
            && existsAfter(
                 /databases/$(database)/documents/stores/$(request.resource.data.storeId))
            && getAfter(
                 /databases/$(database)/documents/stores/$(request.resource.data.storeId)
               ).data.ownerId == uid())
          // A developer or admin opening another profile keeps their role and
          // only gains a storeId. Without this an admin could never become a
          // developer, because the branch above only accepts CUSTOMER.
          || (isSeller()
            && unchanged('role')
            && request.resource.data.storeId is string
            && existsAfter(
                 /databases/$(database)/documents/stores/$(request.resource.data.storeId))
            && getAfter(
                 /databases/$(database)/documents/stores/$(request.resource.data.storeId)
               ).data.ownerId == uid())
        );

      // Admins may change only role and store linkage. SELLER is valid only
      // when the target user already owns the linked store; a role label alone
      // must never unlock seller routes without a real store.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'storeId', 'updatedAt'])
        && (
          request.resource.data.role == 'ADMIN'
          || (request.resource.data.role == 'CUSTOMER'
            && request.resource.data.storeId == null)
          || (request.resource.data.role == 'SELLER'
            && request.resource.data.storeId is string
            && storeDoc(request.resource.data.storeId).ownerId == userId)
        );
      allow delete: if isAdmin();

      match /tokens/{tokenId} {
        allow read, write: if isSignedIn() && userId == uid();
      }
    }

    // -------------------------------------------------------------- stores
    match /stores/{storeId} {
      allow read: if true;

      // A seller opens their own store, always PENDING (an admin activates it).
      allow create: if isSignedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60;

      // A developer asks for verification (needed to sell paid apps). Only the
      // request field moves; approval is the admin's branch below.
      allow update: if (isSeller() && resource.data.ownerId == uid()
          && unchanged('ownerId')
          && unchanged('verified')
          && request.resource.data.verificationStatus == 'PENDING');

      allow update: if (isSeller() && resource.data.ownerId == uid()
          && unchanged('ownerId')
          && unchanged('status')
          // Verification is the admin's decision, never the owner's. The request
          // branch above is the only way an owner may touch these two fields.
          && unchanged('verified')
          && unchanged('verificationStatus')
          && unchanged('rating')
          && unchanged('ratingCount')
          && unchanged('createdAt')
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 60)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ products
    match /products/{productId} {
      function isPublic() {
        return resource.data.status == 'ACTIVE';
      }

      function validProduct() {
        return request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 120
          && request.resource.data.price is int
          && request.resource.data.price >= 0
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() > 0
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 6
          && (!request.resource.data.keys().hasAny(['offerEndsAt'])
              || request.resource.data.offerEndsAt is int)
          && request.resource.data.screenshots is list
          && request.resource.data.screenshots.size() <= 8
          && request.resource.data.status in ['DRAFT', 'ACTIVE', 'ARCHIVED']
          // Every app points at a build: an uploaded APK or a link.
          && request.resource.data.apkUrl is string
          && request.resource.data.apkUrl.size() > 8
          // A build is either a Firebase Storage URL or a link the developer
          // controls; nothing else should end up in the field.
          && (request.resource.data.apkUrl.matches('https://.*')
              || request.resource.data.apkUrl.matches('gs://.*'));
      }

      // The only fields a shopper's order transaction may move, and stock may
      // never go negative.
      function stockOnlyChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock', 'unitsSold', 'updatedAt'])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0;
      }

      // Split so the storefront's list queries never depend on get(): Firestore
      // does not evaluate get() for list operations, and a rule that needs it
      // denies the whole query.
      allow get: if isPublic()
        || (isSeller() && resource.data.storeId == myStoreId())
        || isAdmin();
      // A list rule is evaluated per returned document, so each of these
      // branches only ever matches rows the caller is entitled to see. Without
      // the last two, an admin could not list reported apps and a seller could
      // not list their own drafts.
      allow list: if isPublic()
        || (isSeller() && resource.data.storeId == myStoreId())
        || isAdmin();

      function paidNeedsVerification() {
        return request.resource.data.price == 0
          || (hasStore(request.resource.data.storeId)
            && storeDoc(request.resource.data.storeId).get('verified', false) == true);
      }

      allow create: if isSeller()
        && request.resource.data.storeId == myStoreId()
        && (request.resource.data.status != 'ACTIVE' || storeIsApproved())
        && validProduct()
        && paidNeedsVerification();

      function storeIsApproved() {
        return hasStore(myStoreId()) && storeDoc(myStoreId()).status == 'ACTIVE';
      }

      allow update: if isSeller()
        && resource.data.storeId == myStoreId()
        && unchanged('storeId')
        && unchanged('unitsSold')
        && unchanged('rating')
        && unchanged('ratingCount')
        // Publishing is gated on the store being approved, so a developer cannot
        // wave their own app through moderation.
        && (request.resource.data.status != 'ACTIVE' || storeIsApproved())
        && validProduct()
        && paidNeedsVerification();

      // Buyers decrement stock (and restore it on cancellation) inside the
      // order transaction. Prices and titles stay untouched.
      allow update: if isSignedIn()
        && resource.data.status == 'ACTIVE'
        && stockOnlyChange();

      // Anyone signed in can flag a published app. Only the flag fields move and
      // the count may only rise by one — without this the admin's "Reported
      // apps" queue could never contain anything.
      allow update: if isSignedIn()
        && resource.data.status == 'ACTIVE'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reported', 'reportReason', 'reportCount', 'updatedAt'])
        && request.resource.data.reported == true
        && request.resource.data.reportReason is string
        && request.resource.data.reportReason.size() <= 200
        && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1;

      // Moderation (Admin → Products).
      allow update: if isAdmin();

      allow delete: if (isSeller() && resource.data.storeId == myStoreId()) || isAdmin();
    }

    // ---------------------------------------------------------- categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------ wishlist
    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && userId == uid();

      match /items/{productId} {
        allow read, write: if isSignedIn() && userId == uid()
          && request.resource.data.productId == productId;
      }
    }

    // -------------------------------------------------------------- orders
    match /orders/{orderId} {
      function isParticipant() {
        return isSignedIn() && (
          resource.data.buyerId == uid()
          || (resource.data.storeIds is list && (myStoreId() != null && myStoreId() in resource.data.storeIds))
        );
      }

      function itemValid(index) {
        let item = request.resource.data.items[index];
        let product = get(/databases/$(database)/documents/products/$(item.productId)).data;
        // A digital install has no inventory to run out of, and a free app costs
        // zero — requiring unitPrice > 0 or stock >= quantity made installing a
        // free app impossible.
        return item.quantity is int
          && item.quantity > 0
          && item.quantity <= 99
          && item.unitPrice is int
          && item.unitPrice >= 0
          && item.unitPrice == product.price
          && item.storeId == product.storeId
          && product.status == 'ACTIVE';
      }

      function lineTotal(index) {
        let item = request.resource.data.items[index];
        return item.unitPrice * item.quantity;
      }

      // The subtotal must be the sum of the lines. Without this a client could
      // declare any subtotal it liked and the totals would still "add up".
      function subtotalMatches() {
        let items = request.resource.data.items;
        let sum = lineTotal(0)
          + (items.size() > 1 ? lineTotal(1) : 0)
          + (items.size() > 2 ? lineTotal(2) : 0)
          + (items.size() > 3 ? lineTotal(3) : 0)
          + (items.size() > 4 ? lineTotal(4) : 0)
          + (items.size() > 5 ? lineTotal(5) : 0)
          + (items.size() > 6 ? lineTotal(6) : 0)
          + (items.size() > 7 ? lineTotal(7) : 0);
        return request.resource.data.subtotal == sum;
      }

      function totalsConsistent() {
        let shipping = request.resource.data.shipping;
        return request.resource.data.total == request.resource.data.subtotal + shipping
          && shipping == 0
          && request.resource.data.subtotal >= 0
          && request.resource.data.total >= 0;
      }

      function editableKeys() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'timeline', 'cancelledBy']);
      }

      function sellerTransition() {
        let current = resource.data.status;
        let next = request.resource.data.status;
        return (current == 'PENDING' && next == 'CONFIRMED')
          || (current == 'CONFIRMED' && next == 'PACKED')
          || (current == 'PACKED' && next == 'SHIPPED')
          || (current == 'SHIPPED' && next == 'DELIVERED');
      }

      function buyerCancel() {
        return resource.data.buyerId == uid()
          && request.resource.data.status == 'CANCELLED'
          && resource.data.status in ['PENDING', 'CONFIRMED'];
      }

      function sellerOfRecord() {
        return isSignedIn()
          && resource.data.storeIds is list
          && (myStoreId() != null && myStoreId() in resource.data.storeIds);
      }

      allow get: if isParticipant() || isAdmin();
      // Buyer's own list stays get()-free so "My apps" always loads. Sellers
      // list the installs of their apps, admins list everything.
      allow list: if (isSignedIn() && resource.data.buyerId == uid())
        || (isSeller() && (myStoreId() != null && myStoreId() in resource.data.storeIds))
        || isAdmin();

      // Prices and stock are verified against the product documents, so a
      // tampered cart cannot change what is charged.
      allow create: if isSignedIn()
        && request.resource.data.buyerId == uid()
        // An install is complete the moment it is written, so DELIVERED is as
        // valid as PENDING. Only accepting PENDING made installing impossible.
        && request.resource.data.status in ['PENDING', 'DELIVERED']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 8
        && request.resource.data.storeIds is list
        && request.resource.data.storeIds.size() > 0
        && subtotalMatches()
        && totalsConsistent()
        && itemValid(0)
        && (request.resource.data.items.size() < 2 || itemValid(1))
        && (request.resource.data.items.size() < 3 || itemValid(2))
        && (request.resource.data.items.size() < 4 || itemValid(3))
        && (request.resource.data.items.size() < 5 || itemValid(4))
        && (request.resource.data.items.size() < 6 || itemValid(5))
        && (request.resource.data.items.size() < 7 || itemValid(6))
        && (request.resource.data.items.size() < 8 || itemValid(7));

      allow update: if editableKeys() && (
        (sellerOfRecord() && sellerTransition())
        || buyerCancel()
        || isAdmin()
      );

      allow delete: if false;
    }

    // ------------------------------------------------------- notifications
    match /notifications/{userId} {
      allow read: if isSignedIn() && userId == uid();

      match /items/{itemId} {
        allow read: if isSignedIn() && userId == uid();
        // The client may only flip the read flag.
        allow update: if isSignedIn() && userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        // A seller's "new order" notice is written by the buyer who placed it.
        // Scoped to order notices with a bounded body.
        allow create: if isSignedIn()
          && request.resource.data.type in ['ORDER', 'INSTALL', 'APPROVAL', 'SYSTEM']
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 200
          && request.resource.data.deepLink is string
          && request.resource.data.read == false;

        allow delete: if false;
      }
    }

    // ------------------------------------------------------------ platform
    match /platform/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /media_usage/{docId} {
      allow read, write: if isAdmin();
    }

    // Deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

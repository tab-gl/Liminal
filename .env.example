# Sproutly — every variable the project reads, in one place.
#
# Copy to `.env` and fill in the blanks. `.env` is git-ignored; this file is not.
# Anything marked PUBLIC is safe to commit and is already the built-in default.

# ── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=tab-gl
FIREBASE_PROJECT_NUMBER=919591212641
GOOGLE_SERVICES_JSON=app/google-services.json
# base64 -w0 app/google-services.json   (only needed if you stop committing the file)
GOOGLE_SERVICES_JSON_BASE64=

# ── Android client ──────────────────────────────────────────────────────────
# PUBLIC: web OAuth client id used by Google Sign-In.
SPROUTLY_GOOGLE_WEB_CLIENT_ID=919591212641-haoe16l24oej5pbvrdmc5csceumduv5l.apps.googleusercontent.com

# ── Cloudinary ──────────────────────────────────────────────────────────────
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# Used by Cloud Functions only (the app uploads through the unsigned preset).
CLOUDINARY_URL=
# PUBLIC: the cloud name appears in every asset URL.
SPROUTLY_CLOUDINARY_CLOUD_NAME=wjoegjfk
# PUBLIC: an unsigned upload preset, locked to the sproutly folder.
SPROUTLY_CLOUDINARY_UPLOAD_PRESET=sproutly_unsigned

# ── Release signing, local builds ───────────────────────────────────────────
# Or put these in keystore.properties (git-ignored) — same keys, same meaning.
SPROUTLY_KEYSTORE_PATH=./sproutly-release.jks
SPROUTLY_KEYSTORE_PASSWORD=
SPROUTLY_KEY_ALIAS=sproutly
SPROUTLY_KEY_PASSWORD=

# ── GitHub Actions secrets (CI signing) ─────────────────────────────────────
# The workflow accepts either naming scheme: SPROUTLY_* or ANDROID_*.
# Push them all with: ./tools/env-to-secrets.sh .env
SPROUTLY_KEYSTORE_BASE64=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
ANDROID_KEY_ALIAS=sproutly

# ── Functions deploy (Blaze only; the app runs on Spark without it) ─────────
GCP_PROJECT_ID=tab-gl
GCP_REGION=asia-south1
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=

# ── Optional integrations ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=
POSTHOG_API_KEY=

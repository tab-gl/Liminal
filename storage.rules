rules_version = '2';

// App builds live in Cloud Storage, not Firestore: a Firestore document is capped
// at 1 MiB, and a real APK is tens of megabytes. Firestore keeps the download URL
// and the version metadata; Storage keeps the bytes.
service firebase.storage {
  match /b/{bucket}/o {

    // Builds are readable by anyone signed in — people install apps, so the file
    // has to be downloadable by them. The URL itself is unguessable.
    match /apks/{storeId}/{fileName} {
      allow read: if request.auth != null;

      // Only the owner of that store may upload, only an APK, and only up to
      // 100 MB. `request.resource.size` is the number of bytes being written.
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType in [
             'application/vnd.android.package-archive',
             'application/octet-stream'
           ]
        && firestore.exists(/databases/(default)/documents/stores/$(storeId))
        && firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // Listing imagery still goes to Cloudinary; nothing else is public here.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
